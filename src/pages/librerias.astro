---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
    <section class="mx-4 sm:mx-12 md:mx-40 lg:mx-60 xl:mx-80">
        
        <h3 class="text-xl py-10">
            Podés encontrar nuestros títulos en...
        </h3>
        <!-- <h3 class="text-xl">
            Podés encontrar nuestros títulos en estas librerías amigas:
        </h3> -->
        <ul class="flex justify-center items-center text-gray-800 pb-6">
            <li>
                <a href="https://www.instagram.com/lacomarcalibros" target="_blank" class="font-bold px-4 transition-colors ease-in-out rounded-4xl hover:text-gray-600 text-2xl ">La Comarca Libros</a>
                <br>
                <a href="https://maps.app.goo.gl/EpQpG9FDUa75nCwj8" target="_blank" class="flex items-start sm:items-center w-fit space-x-2 group px-4 py-1 gap-2 hover:text-black ">
                    <svg xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-map-pin"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M18.364 4.636a9 9 0 0 1 .203 12.519l-.203 .21l-4.243 4.242a3 3 0 0 1 -4.097 .135l-.144 -.135l-4.244 -4.243a9 9 0 0 1 12.728 -12.728zm-6.364 3.364a3 3 0 1 0 0 6a3 3 0 0 0 0 -6z" /></svg>
                    <p >Av. Coronel Díaz 1492, CABA</p>
                </a>
                <div class="flex items-start sm:items-center w-fit space-x-2 group px-4 py-1 gap-2">
                    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-phone"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 3a1 1 0 0 1 .877 .519l.051 .11l2 5a1 1 0 0 1 -.313 1.16l-.1 .068l-1.674 1.004l.063 .103a10 10 0 0 0 3.132 3.132l.102 .062l1.005 -1.672a1 1 0 0 1 1.113 -.453l.115 .039l5 2a1 1 0 0 1 .622 .807l.007 .121v4c0 1.657 -1.343 3 -3.06 2.998c-8.579 -.521 -15.418 -7.36 -15.94 -15.998a3 3 0 0 1 2.824 -2.995l.176 -.005h4z" /></svg>
                    <p >4822-0419</p>
                </div>
                <div class="flex items-start sm:items-center w-fit space-x-2 group px-4 py-1 gap-2">
                    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z" /><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z" /></svg>
                    <p >lacomarcalibros@hotmail.com</p>
                </div>
                <br>
            </li>
        </ul>

        <form
            id="contactForm"
            class="bg-gray-100 p-8 border border-zinc-200 rounded-2xl"
        >
            <h3 class="text-[1.1rem]">
                Si tenés una librería y querés ofrecer libros de El Destino, por
                favor, completá este formulario:
            </h3>
            <br />

            <section class="space-y-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8">
                <div>
                    <label
                        for="nombre"
                        class="block text-sm font-medium text-gray-700"
                        >Nombre:</label
                    >
                    <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="libreria"
                        class="block text-sm font-medium text-gray-700"
                        >Librería:</label
                    >
                    <input
                        type="text"
                        id="libreria"
                        name="libreria"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="direccion"
                        class="block text-sm font-medium text-gray-700"
                        >Dirección:</label
                    >
                    <input
                        type="text"
                        id="direccion"
                        name="direccion"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="localidad"
                        class="block text-sm font-medium text-gray-700"
                        >Localidad:</label
                    >
                    <input
                        type="text"
                        id="localidad"
                        name="localidad"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="codigo_postal"
                        class="block text-sm font-medium text-gray-700"
                        >Código postal:</label
                    >
                    <input
                        type="text"
                        id="codigo_postal"
                        name="codigo_postal"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="email"
                        class="block text-sm font-medium text-gray-700"
                        >Correo electrónico:</label
                    >
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="telefono"
                        class="block text-sm font-medium text-gray-700"
                        >Teléfono:</label
                    >
                    <input
                        type="tel"
                        id="telefono"
                        name="telefono"
                        class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded-full"
                        required
                    />
                </div>

                <div>
                    <label
                        for="telefono"
                        class="invisible block text-sm font-medium text-gray-700"
                    >
                        space</label
                    >
                    <button
                        id="submitButton"
                        type="submit"
                        class="bg-black border text-white p-[0.4rem] mt-1 w-full hover:bg-gray-800 transition duration-300 cursor-pointer rounded-full disabled:bg-gray-500 disabled:text-gray-300 disabled:cursor-default disabled:hover:bg-gray-500"
                    >
                        Enviar formulario
                    </button>
                    <small
                        id="success"
                        class="relative text-center text-blue-600 w-full mt-4 hidden"
                        >Formulario enviado correctamente</small
                    >
                    <small
                        id="error"
                        class="relative text-center text-red-600 w-full mt-4 hidden"
                        >Hubo un error al enviar el mensaje. Por favor,
                        inténtalo de nuevo</small
                    >
                </div>
            </section>
        </form>
        <br />
        <br />
    </section>

    <script is:inline>
        document
            .getElementById("contactForm")
            .addEventListener("submit", async (event) => {
                event.preventDefault();

                const form = event.target;
                const formData = new FormData(form);
                const inputs = document.getElementsByTagName("input");
                const successElement = document.getElementById("success");
                const errorElement = document.getElementById("error");
                const submitButton = document.getElementById("submitButton"); // Obtén el botón

                // Deshabilitar el botón y los inputs
                submitButton.disabled = true;
                submitButton.classList.add("bg-gray-500", "cursor-not-allowed"); // Cambia el estilo del botón

                for (let i = 0; i < inputs.length; i++) {
                    inputs[i].disabled = true;
                }

                // Convertir FormData a un objeto JSON
                const jsonObject = {};
                formData.forEach((value, key) => {
                    jsonObject[key] = value;
                });

                try {
                    const response = await fetch("/api/send-email", {
                        method: "POST",
                        body: JSON.stringify(jsonObject),
                        headers: {
                            "Content-Type": "application/json",
                        },
                    });

                    if (response.ok) {
                        successElement.classList.remove("hidden");
                        form.reset(); // Limpia el formulario después del éxito

                        // No habilitar el botón ni los inputs aquí, ya que permanecen deshabilitados
                    } else {
                        const errorData = await response.json();
                        console.error("Error al enviar el mensaje:", errorData);
                        errorElement.classList.remove("hidden");
                        // Habilitar el botón y los inputs en caso de error
                        submitButton.disabled = false;
                        submitButton.classList.remove(
                            "bg-gray-500",
                            "cursor-not-allowed",
                        );
                        for (let i = 0; i < inputs.length; i++) {
                            inputs[i].disabled = false;
                        }
                    }
                } catch (error) {
                    console.error("Error de red:", error);
                    errorElement.classList.remove("hidden");
                    // Habilitar el botón y los inputs en caso de error
                    submitButton.disabled = false;
                    submitButton.classList.remove(
                        "bg-gray-500",
                        "cursor-not-allowed",
                    );
                    for (let i = 0; i < inputs.length; i++) {
                        inputs[i].disabled = false;
                    }
                }
            });
    </script>
</BaseLayout>
