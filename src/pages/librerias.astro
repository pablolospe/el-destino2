---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
    <section class="mx-4 md:mx-60">
        <br />
        <!-- <h3 class="text-xl">
            Podés encontrar nuestros títulos en estas librerías amigas:
        </h3>
        <ul class="p-6">
            <li>Librería de la Manzana</li>
            <li>Librería de la Esquina</li>
        </ul> -->

        <form
            id="contactForm"
            class="space-y-4 bg-gray-100 p-8 border border-zinc-200 rounded"
        >
            <h3 class="text-[1.1rem]">
                Si tenés una librería y querés ofrecer libros de El Destino, por
                favor, completá este formulario:
            </h3>
            <br />
            <div>
                <label
                    for="nombre"
                    class="block text-sm font-medium text-gray-700"
                    >Nombre:</label
                >
                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="libreria"
                    class="block text-sm font-medium text-gray-700"
                    >Librería:</label
                >
                <input
                    type="text"
                    id="libreria"
                    name="libreria"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="direccion"
                    class="block text-sm font-medium text-gray-700"
                    >Dirección:</label
                >
                <input
                    type="text"
                    id="direccion"
                    name="direccion"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="localidad"
                    class="block text-sm font-medium text-gray-700"
                    >Localidad:</label
                >
                <input
                    type="text"
                    id="localidad"
                    name="localidad"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="codigo_postal"
                    class="block text-sm font-medium text-gray-700"
                    >Código Postal:</label
                >
                <input
                    type="text"
                    id="codigo_postal"
                    name="codigo_postal"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="email"
                    class="block text-sm font-medium text-gray-700"
                    >Correo Electrónico:</label
                >
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="telefono"
                    class="block text-sm font-medium text-gray-700"
                    >Teléfono:</label
                >
                <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div class="flex flex-col justify-center items-center">
                <button
                    id="submitButton"
                    type="submit"
                    class="bg-black text-white mt-4 px-4 py-2 h-full hover:bg-gray-800 transition duration-300 cursor-pointer rounded disabled:bg-gray-500 disabled:text-gray-300 disabled:cursor-default disabled:hover:bg-gray-500"
                >
                    Enviar formulario
                </button>
                <small
                    id="success"
                    class="relative text-center text-blue-600 w-full mt-4 hidden"
                    >Formulario enviado correctamente</small
                >
                <small
                    id="error"
                    class="relative text-center text-red-600 w-full mt-4 hidden"
                    >Hubo un error al enviar el mensaje. Por favor, inténtalo de
                    nuevo</small
                >
            </div>
        </form>
        <br />
        <br />
    </section>

    <script is:inline>
        document
            .getElementById("contactForm")
            .addEventListener("submit", async (event) => {
                event.preventDefault();

                const form = event.target;
                const formData = new FormData(form);
                const inputs = document.getElementsByTagName("input");
                const successElement = document.getElementById("success");
                const errorElement = document.getElementById("error");
                const submitButton = document.getElementById("submitButton"); // Obtén el botón

                // Deshabilitar el botón y los inputs
                submitButton.disabled = true;
                submitButton.classList.add("bg-gray-500", "cursor-not-allowed"); // Cambia el estilo del botón

                for (let i = 0; i < inputs.length; i++) {
                    inputs[i].disabled = true;
                }

                // Convertir FormData a un objeto JSON
                const jsonObject = {};
                formData.forEach((value, key) => {
                    jsonObject[key] = value;
                });

                try {
                    const response = await fetch("/api/send-email", {
                        method: "POST",
                        body: JSON.stringify(jsonObject),
                        headers: {
                            "Content-Type": "application/json",
                        },
                    });

                    if (response.ok) {
                        successElement.classList.remove("hidden");
                        form.reset(); // Limpia el formulario después del éxito

                        // No habilitar el botón ni los inputs aquí, ya que permanecen deshabilitados
                    } else {
                        const errorData = await response.json();
                        console.error("Error al enviar el mensaje:", errorData);
                        errorElement.classList.remove("hidden");
                        // Habilitar el botón y los inputs en caso de error
                        submitButton.disabled = false;
                        submitButton.classList.remove(
                            "bg-gray-500",
                            "cursor-not-allowed",
                        );
                        for (let i = 0; i < inputs.length; i++) {
                            inputs[i].disabled = false;
                        }
                    }
                } catch (error) {
                    console.error("Error de red:", error);
                    errorElement.classList.remove("hidden");
                    // Habilitar el botón y los inputs en caso de error
                    submitButton.disabled = false;
                    submitButton.classList.remove(
                        "bg-gray-500",
                        "cursor-not-allowed",
                    );
                    for (let i = 0; i < inputs.length; i++) {
                        inputs[i].disabled = false;
                    }
                }
            });
    </script>
</BaseLayout>
