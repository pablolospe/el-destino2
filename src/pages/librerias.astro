---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
    <section class="mx-4 md:mx-60">
        <br />
        <h3 class="text-xl">
            Podés encontrar nuestros títulos en estas librerías amigas:
        </h3>
        <ul class="p-6">
            <li>Librería de la Manzana</li>
            <li>Librería de la Esquina</li>
        </ul>

        <form id="contactForm" class="space-y-4 bg-gray-100 p-8 border border-zinc-200 rounded">
            <h3 class="text-[1.1rem]">
                Si tenés una librería y querés ofrecer libros de El Destino, por
                favor, completá este formulario:
            </h3>
            <br />
            <div>
                <label
                    for="nombre"
                    class="block text-sm font-medium text-gray-700"
                    >Nombre:</label
                >
                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="libreria"
                    class="block text-sm font-medium text-gray-700"
                    >Librería:</label
                >
                <input
                    type="text"
                    id="libreria"
                    name="libreria"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="direccion"
                    class="block text-sm font-medium text-gray-700"
                    >Dirección:</label
                >
                <input
                    type="text"
                    id="direccion"
                    name="direccion"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="localidad"
                    class="block text-sm font-medium text-gray-700"
                    >Localidad:</label
                >
                <input
                    type="text"
                    id="localidad"
                    name="localidad"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="codigo_postal"
                    class="block text-sm font-medium text-gray-700"
                    >Código Postal:</label
                >
                <input
                    type="text"
                    id="codigo_postal"
                    name="codigo_postal"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="email"
                    class="block text-sm font-medium text-gray-700"
                    >Correo Electrónico:</label
                >
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div>
                <label
                    for="telefono"
                    class="block text-sm font-medium text-gray-700"
                    >Teléfono:</label
                >
                <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    class="mt-1 block w-full border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm rounded"
                    required
                />
            </div>

            <div class="flex justify-center">
                <button
                    type="submit"
                    class="bg-black text-white px-4 py-2 h-full hover:bg-gray-800 transition duration-300 cursor-pointer"
                >
                    Enviar formulario
                </button>
            </div>
        </form>
        <br />
        <br />
    </section>

    <script is:inline>
        document
            .getElementById("contactForm")
            .addEventListener("submit", async (event) => {
                event.preventDefault();

                const form = event.target;
                const formData = new FormData(form);

                // Convertir FormData a un objeto JSON
                const jsonObject = {};
                formData.forEach((value, key) => {
                    jsonObject[key] = value;
                });

                // console.log(jsonObject); // Verifica la estructura antes de enviarla

                try {
                    const response = await fetch("/api/send-email", {
                        method: "POST",
                        body: JSON.stringify(jsonObject),
                        headers: {
                            "Content-Type": "application/json", // Cambiado a JSON
                        },
                    });

                    if (response.ok) {
                        alert("¡Mensaje enviado correctamente!");
                        form.reset(); // Limpia el formulario después del éxito
                    } else {
                        const errorData = await response.json();
                        console.error("Error al enviar el mensaje:", errorData);
                        alert(
                            "Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.",
                        );
                    }
                } catch (error) {
                    console.error("Error de red:", error);
                    alert(
                        "Hubo un error de red al enviar el mensaje. Por favor, inténtalo de nuevo.",
                    );
                }
            });
    </script>
</BaseLayout>
