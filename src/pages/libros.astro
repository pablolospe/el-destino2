---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import EntriesOne from "@/components/entries/EntriesOne.astro";
const allPosts = await getCollection("posts");
import Hero from "@/components/landing/Hero.astro";
import Cta from "@/components/global/Cta.astro";
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

// Sort posts by date in descending order (newest first)
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<BaseLayout>
  <section class="h-full mx-4 lg:my-20">
    <ul
      class="grid grid-cols-1 mb-8 gap-y-8 lg:grid-cols-2 sm:mx-20 sm:gap-20 lg:mx-40 lg:gap-40 sm:grid-cols-2 items-center"
    >
      {
        sortedPosts.map((post) => (
          <EntriesOne
            url={"/posts/" + post.slug}
            title={post.data.title}
            description={post.data.description}
            alt={post.data.title}
            pubDate={post.data.pubDate.toString().slice(0, 10)}
            author={post.data.author}
            image={post.data.image.url}
            tags={post.data.tags}
          />
        ))
      }
    </ul>

    <!-- TAGS -->
    <!-- <ol role="list" class="flex flex-wrap gap-3">
                      {
                        tags.map((tag) => (
                          <li class="inline-flex items-center uppercase mx-auto hover:text-blue-500 text-xs font-medium text-black">
                            <a href={`/tags/${tag}`}>{tag}</a>
                          </li>
                        ))
                      }
                    </ol> -->
  </section>
</BaseLayout>
