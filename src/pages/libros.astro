---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import EntriesOne from "@/components/entries/EntriesOne.astro";
const allPosts = await getCollection("posts");
import Footer from "@/components/global/Footer.astro";
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

// Sort posts by date in descending order (newest first)
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<BaseLayout>
  
  <section class="flex flex-col items-center justify-center my-auto">
    <div class="flex flex-1 px-8 md:px-12 mx-auto max-w-7xl py-4 lg:px-8 justify-center items-center">
      <ul
        class="grid grid-cols-1 mb-8 gap-y-8 lg:grid-cols-2 sm:mx-20 sm:gap-20 lg:mx-52 lg:gap-52 sm:grid-cols-2 justify-center items-center"
      >
        {
          sortedPosts.map((post) => (
            <EntriesOne
              url={"/posts/" + post.slug}
              title={post.data.title}
              description={post.data.description}
              alt={post.data.title}
              pubDate={post.data.pubDate.toString().slice(0, 10)}
              author={post.data.author}
              image={post.data.image.url}
              tags={post.data.tags}
            />
          ))
        }
      </ul>
    </div>
  </section>
  <Footer />
</BaseLayout>
