---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import EntriesOne from "@/components/entries/EntriesOne.astro";
const allPosts = await getCollection("posts");
import Footer from "@/components/global/Footer.astro";
import { fade } from "astro:transitions";
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

// Sort posts by date in descending order (newest first)
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<BaseLayout>
  
  <section class="flex grow flex-col items-center justify-center ">
    
    <div class="flex flex-col flex-1 px-8 md:px-12 mx-auto max-w-7xl py-4 lg:px-8 h-full justify-center">
      <h1
        transition:animate={fade({ duration: "1s" })}
        class="text-2xl text-center tracking-widest font-bold font-display text-black mb-16"
      >
        Todos nuestros libros
      </h1>
      <ul
        class="grid grid-cols-1 mb-8 gap-y-8 lg:grid-cols-7 sm:mx-10 sm:gap-20 sm:grid-cols-2 lg:mx-0 lg:gap-10 justify-center items-center h-full"
      >
        {
          sortedPosts.map((post) => (
            <div class="md:hover:scale-110 lg:hover:scale-120 transition-all duration-600">

            <EntriesOne
              url={"/posts/" + post.slug}
              title={post.data.title}
              description={post.data.description}
              alt={post.data.title}
              pubDate={post.data.pubDate.toString().slice(0, 10)}
              author={post.data.author}
              image={post.data.image.url}
              tags={post.data.tags}              
              />
              </div>
          ))
        }
      </ul>
    </div>
  </section>
  <Footer />
</BaseLayout>
