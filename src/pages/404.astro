---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="404 - Contenido no encontrado">
  <div class="flex flex-col items-center justify-center min-h-[calc(100vh-100px)] text-center px-4">
    <h1 class="text-6xl md:text-8xl font-bold text-gray-800 mb-4">404</h1>
    <p class="text-xl md:text-2xl text-gray-600 mb-8">Contenido no encontrado</p>
    <div class="flex space-x-4">
      <a href="/" class="px-6 py-3 border border-gray-300 bg-black text-white rounded-full hover:bg-white hover:text-black transition-colors duration-300 cursor-pointer">
        Ir a la página de inicio
      </a>
      <button onclick="history.back()" class="px-6 py-3 border border-gray-300 bg-[#ecfd83] text-black rounded-full hover:bg-black hover:text-[#ecfd83] transition-colors duration-300 cursor-pointer">
        Volver a la página anterior
      </button>
    </div>
  </div>
</BaseLayout>