---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmailCopy from "@/components/EmailCopy.astro";
import Footer from "@/components/global/Footer.astro";
import PhoneCopy from "@/components/PhoneCopy.astro";
---

<BaseLayout>
    
        <section
            class="flex-1 flex justify-center items-center mx-4 md:mx-60 text-lg font-light text-left"
        >
            <div class="w-fit flex flex-col gap-1">
                <EmailCopy />
                <PhoneCopy />
                
                <p class="ml-4 p-1">
                    Ciudad de Buenos Aires, República Argentina
                </p>
            </div>
        </section>
        <Footer />

</BaseLayout>
