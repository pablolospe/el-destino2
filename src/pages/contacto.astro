---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmailCopy from "@/components/contacto/EmailCopy.astro";
import PhoneCopy from "@/components/contacto/PhoneCopy.astro";
import Footer from "@/components/global/Footer.astro";
import { siteConfig } from "@/config/seo-aeo";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.localBusiness.name,
  "image": siteConfig.localBusiness.logo,
  "email": siteConfig.localBusiness.email,
  "telephone": siteConfig.localBusiness.telephone || undefined,
  "url": `${siteConfig.siteUrl.replace(/\/$/, "")}/contacto`,
  "priceRange": siteConfig.localBusiness.priceRange,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": siteConfig.localBusiness.address.addressLocality,
    "addressCountry": siteConfig.localBusiness.address.addressCountry,
    "postalCode": siteConfig.localBusiness.address.postalCode || undefined
  }
};
---

<BaseLayout title={`Contacto | ${siteConfig.localBusiness.name}`} description={`Ponte en contacto con ${siteConfig.localBusiness.name}.`} canonical={`${siteConfig.siteUrl.replace(/\/$/, "")}/contacto`}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <section
        class="w-full flex-grow flex-1 flex justify-center items-center py-12 px-4"
    >
        <!-- Marco con el mismo estilo de las librerías -->
        <div class="border border-zinc-200 rounded-lg p-6 bg-white shadow-sm flex flex-col gap-4 max-w-md md:max-w-lg w-full">
            <div>
                <h2 class="font-bold text-2xl text-gray-800 mb-2">Contacto</h2>
                <div class="border-t border-zinc-100 my-2"></div>
            </div>
            
            <div class="flex flex-col gap-2 text-gray-800">
                <div class="w-full flex justify-start">
                    <EmailCopy />
                </div>
                <div class="w-full flex justify-start">
                    <PhoneCopy />
                </div>
                <div class="w-full flex justify-start">
                    <div class="flex items-center w-fit gap-2 sm:gap-4 px-2 py-1.5 sm:px-4 sm:py-2 hover:bg-gray-200 hover:text-black cursor-default rounded-md select-none transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-map-pin shrink-0 sm:w-6 sm:h-6" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"/><path d="M18.364 4.636a9 9 0 0 1 .203 12.519l-.203 .21l-4.243 4.242a3 3 0 0 1 -4.097 .135l-.144 -.135l-4.244 -4.243a9 9 0 0 1 12.728 -12.728zm-6.364 3.364a3 3 0 1 0 0 6a3 3 0 0 0 0 -6z" /></svg>
                        <span class="text-[13px] sm:text-base md:text-lg">Ciudad de Buenos Aires, República Argentina</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <Footer />
</BaseLayout>
