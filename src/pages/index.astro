---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntriesOne from "@/components/entries/EntriesOne.astro";
// import ImagePopup from "@/components/ImagePopup.astro";
const allPosts = await getCollection("posts");
import Hero from "@/components/landing/Hero.astro";
import Footer from "@/components/global/Footer.astro";
import { siteConfig } from "@/config/seo-aeo";
// import { Image } from "astro:assets";
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
// import presentacion from "public/images/presentacion-libro.webp";

// Sort posts by date in descending order (newest first)
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

// Build structured AEO graph data from siteConfig
const homepageGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Publisher",
      "@id": `${siteConfig.siteUrl}#organization`,
      "name": siteConfig.localBusiness.name,
      "url": siteConfig.siteUrl,
      "logo": siteConfig.localBusiness.logo,
      "description": siteConfig.defaultDescription,
      "sameAs": siteConfig.localBusiness.sameAs,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": siteConfig.localBusiness.address.addressLocality,
        "addressCountry": siteConfig.localBusiness.address.addressCountry
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios Editoriales",
        "itemListElement": siteConfig.editorialServices.map((service) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": service.name,
            "description": service.desc
          }
        }))
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteConfig.siteUrl}#website`,
      "url": siteConfig.siteUrl,
      "name": siteConfig.localBusiness.name,
      "publisher": { "@id": `${siteConfig.siteUrl}#organization` }
    },
    {
      "@type": "FAQPage",
      "@id": `${siteConfig.siteUrl}#faq`,
      "mainEntity": siteConfig.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(homepageGraph)} />
  <Hero />

  <!-- POPUP DE LA PRESENTACION DEL LIBRO -->
  <!-- <ImagePopup
  imageSrc="/images/presentacion-libro.webp"
  imageAlt="Presentacion del librosd v"
  /> -->

  <!-- IMAGEN DE LA PRESENTACION DEL LIBRO -->
  <!-- <Image
    class="mx-auto px-4 md:p-0 h-md w-md border-gray-200 border-6 rounded-2xl hover:opacity-100 opacity-70 transition-opacity delay-100"
    height={800}
    width={800}
    src={presentacion}
    alt=""
    loading="eager"
  /> -->

  <section>
    <div class="px-8 md:px-12 mx-auto max-w-7xl py-4 lg:px-8">
      <ul
        class="grid grid-cols-2 mb-8 gap-8 lg:grid-cols-3 sm:mx-10 sm:gap-10 sm:grid-cols-2 lg:mx-20 lg:gap-20 items-center"
      >
        {
          sortedPosts.map((post) => (
            <EntriesOne
              url={"/posts/" + post.slug}
              title={post.data.title}
              description={post.data.description}
              alt={post.data.title}
              pubDate={post.data.pubDate.toString().slice(0, 10)}
              author={post.data.author}
              image={post.data.image.url}
              tags={post.data.tags}
            />
          ))
        }
      </ul>
    </div>
  </section>
  <Footer />
</BaseLayout>
