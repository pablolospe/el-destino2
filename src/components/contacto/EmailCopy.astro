---
// EmailCopy.astro
---

<div class="flex items-center w-fit space-x-2 group">
  <button
    id="copyEmailButton"
    data-copy-text="eldestinoediciones@gmail.com"
    data-copy-tooltip="¡Email copiado!"
    class="flex flex-row items-center justify-center gap-4 px-4 py-2 hover:bg-gray-200 hover:text-black cursor-pointer rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-500"
  >
    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z" /><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z" /></svg>
    
    <span class="text-lg" id="emailDisplay">eldestinoediciones@gmail.com</span>
    
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-copy text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity duration-600"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path
        d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"
      ></path>
      <path
        d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
      ></path>
    </svg>
  </button>
</div>

<style>
  #copyEmailButton svg {
    pointer-events: none;
  }
</style>