---
// EmailCopy.astro
---

<div class="flex items-center w-fit space-x-2 group">
  <button
    id="copyEmailButton"
    data-copy-text="eldestinoediciones@gmail.com"
    data-copy-tooltip="¡Email copiado!"
    class="flex flex-row items-center justify-center gap-2 sm:gap-4 px-2 py-1.5 sm:px-4 sm:py-2 hover:bg-gray-200 hover:text-black cursor-pointer rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500 w-full sm:w-auto"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-mail shrink-0 sm:w-6 sm:h-6" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"/><path d="M22 7.535V17a3 3 0 0 1-2.824 2.995L19 20H5a3 3 0 0 1-2.995-2.824L2 17V7.535l9.445 6.297.116.066a1 1 0 0 0 .878 0l.116-.066z"/><path d="M19 4c1.08 0 2.027.57 2.555 1.427L12 11.797l-9.555-6.37a3 3 0 0 1 2.354-1.42L5 4z"/></svg>
    
    <span class="text-[13px] sm:text-base md:text-lg select-all" id="emailDisplay">eldestinoediciones@gmail.com</span>
    
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-copy text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity duration-600 shrink-0 sm:w-5 sm:h-5" viewBox="0 0 24 24"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M7 9.667A2.667 2.667 0 0 1 9.667 7h8.666A2.667 2.667 0 0 1 21 9.667v8.666A2.667 2.667 0 0 1 18.333 21H9.667A2.667 2.667 0 0 1 7 18.333z"/><path d="M4.012 16.737A2 2 0 0 1 3 15V5c0-1.1.9-2 2-2h10c.75 0 1.158.385 1.5 1"/></svg>
  </button>
</div>

<style>
  #copyEmailButton svg {
    pointer-events: none;
  }
</style>