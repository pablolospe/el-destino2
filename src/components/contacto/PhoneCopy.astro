<div class="flex items-center w-fit space-x-2 group">
  <button
    id="copyPhoneButton"
    class="flex flex-row items-center justify-center gap-4 px-4 py-2 hover:bg-gray-200 hover:text-black cursor-pointer rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-500"
  >
    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-phone"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 3a1 1 0 0 1 .877 .519l.051 .11l2 5a1 1 0 0 1 -.313 1.16l-.1 .068l-1.674 1.004l.063 .103a10 10 0 0 0 3.132 3.132l.102 .062l1.005 -1.672a1 1 0 0 1 1.113 -.453l.115 .039l5 2a1 1 0 0 1 .622 .807l.007 .121v4c0 1.657 -1.343 3 -3.06 2.998c-8.579 -.521 -15.418 -7.36 -15.94 -15.998a3 3 0 0 1 2.824 -2.995l.176 -.005h4z" /></svg>
    
    <span class="text-lg tracking-widest" id="phoneDisplay">+54 911 60531975</span>
    
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-copy text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity duration-600"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path
        d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"
      ></path>
      <path
        d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
      ></path>
    </svg>
  </button>
</div>

<script is:inline client:load>
  function initializeCopyButton() {
    const phoneDisplay = document.getElementById("phoneDisplay");
    const copyPhoneButton = document.getElementById("copyPhoneButton");

    if (!phoneDisplay || !copyPhoneButton) {
      console.warn("phoneDisplay or copyPhoneButton not found");
      return;
    }

    copyPhoneButton.addEventListener("click", async () => {
      const phone = phoneDisplay.textContent;

      try {
        await navigator.clipboard.writeText(phone);
        console.log("¡Número telefónico copiado al portapapeles!");
      } catch (err) {
        console.error("Error al copiar el número telefónico: ", err);
      }
    });
  }

  initializeCopyButton();
</script>

<style>
  #copyPhoneButton svg {
    pointer-events: none;
  }
</style>