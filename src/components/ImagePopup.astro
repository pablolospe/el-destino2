---
// src/components/ImagePopup.astro
---

<div id="image-popup" class="popup-overlay">
  <div class="popup-container">
    <div class="popup-content">
      <img src="" alt="Imagen ampliada" class="popup-image" id="popup-image-content" />
    </div>
  </div>
</div>

<style>
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    cursor: zoom-out; /* Show zoom-out cursor to indicate it can be closed by clicking */
  }

  .popup-overlay.show {
    opacity: 1;
    visibility: visible;
  }
  
  .popup-container {
    position: relative;
    max-width: 90vw;
    background: transparent;
    padding: 0;
    box-shadow: none;
  }

  .popup-image {
    max-width: 90vw;
    max-height: 80vh;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
  }
  
  @media (max-width: 768px) {
    .popup-container {
      margin: 20px;
    }
    .popup-image {
      max-height: 70vh;
    }
  }
</style>

<script is:inline>
  // This script will run on every page that includes ImagePopup.
  // On client-side navigations, Astro will run it again.
  
  window.openImagePopup = (src) => {
      const popup = document.getElementById('image-popup');
      const popupImage = document.getElementById('popup-image-content');
      if (!popup || !popupImage) {
          console.error("Popup elements not found. Can't open image.");
          return;
      }

      // Find the source image on the page (excluding the popup image itself)
      const sourceImg = Array.from(document.querySelectorAll('img')).find(img => {
          if (img === popupImage) return false;
          const imgCtx = img.getAttribute('src') || '';
          return imgCtx.includes(src) || decodeURIComponent(imgCtx).includes(src);
      });
      window.lastPopupSourceImg = sourceImg;

      popupImage.src = src;

      const triggerOpen = () => {
          if (sourceImg && document.startViewTransition) {
              const transitionName = sourceImg.style.viewTransitionName || getComputedStyle(sourceImg).viewTransitionName;

              if (transitionName && transitionName !== 'none') {
                  // Disable transition names on all other page images so they stay beneath the overlay during animation
                  const otherImages = Array.from(document.querySelectorAll('img')).filter(
                      img => img !== sourceImg && img !== popupImage
                  );
                  otherImages.forEach(img => {
                      img.dataset.savedTransitionName = img.style.viewTransitionName || getComputedStyle(img).viewTransitionName;
                      img.style.viewTransitionName = 'none';
                  });

                  // Swap names inside the transition
                  document.startViewTransition(() => {
                      sourceImg.style.viewTransitionName = 'none';
                      sourceImg.style.opacity = '0'; // Hide page image to avoid ghosting during transition
                      popupImage.style.viewTransitionName = transitionName;
                      popup.classList.add('show');
                  }).finished.finally(() => {
                      sourceImg.style.viewTransitionName = '';
                      popupImage.style.viewTransitionName = '';
                      // Restore original names to other images
                      otherImages.forEach(img => {
                          img.style.viewTransitionName = img.dataset.savedTransitionName || '';
                      });
                  });
                  return;
              }
          }
          popup.classList.add('show');
      };

      if (popupImage.complete) {
          triggerOpen();
      } else {
          popupImage.onload = triggerOpen;
      }
  };

  // --- Setup close listeners ---
  function setupImagePopupListeners() {
      const popup = document.getElementById('image-popup');
      const popupImage = document.getElementById('popup-image-content');
      if (!popup || !popupImage || popup.dataset.listenersAttached === 'true') {
          return;
      }

      const closePopup = () => {
          const sourceImg = window.lastPopupSourceImg;

          if (sourceImg && document.startViewTransition) {
              const transitionName = sourceImg.style.viewTransitionName || getComputedStyle(sourceImg).viewTransitionName;

              if (transitionName && transitionName !== 'none') {
                  // Disable transition names on all other page images during close animation
                  const otherImages = Array.from(document.querySelectorAll('img')).filter(
                      img => img !== sourceImg && img !== popupImage
                  );
                  otherImages.forEach(img => {
                      img.dataset.savedTransitionName = img.style.viewTransitionName || getComputedStyle(img).viewTransitionName;
                      img.style.viewTransitionName = 'none';
                  });

                  // Configure old state (popup has transition name, page source doesn't)
                  popupImage.style.viewTransitionName = transitionName;
                  sourceImg.style.viewTransitionName = 'none';

                  document.startViewTransition(() => {
                      // Configure new state (popup cleared, page source restored)
                      popupImage.style.viewTransitionName = 'none';
                      sourceImg.style.viewTransitionName = '';
                      sourceImg.style.opacity = '1'; // Restore selected page image opacity
                      popup.classList.remove('show');
                  }).finished.finally(() => {
                      popupImage.style.viewTransitionName = '';
                      sourceImg.style.viewTransitionName = '';
                      sourceImg.style.opacity = ''; // Reset inline opacity styles
                      // Restore original names to other images
                      otherImages.forEach(img => {
                          img.style.viewTransitionName = img.dataset.savedTransitionName || '';
                      });
                  });
                  return;
              }
          }
          if (sourceImg) {
              sourceImg.style.opacity = '';
          }
          popup.classList.remove('show');
      };
      
      // Close popup when clicking anywhere on the overlay (including the image itself)
      popup.addEventListener('click', closePopup);
      
      if (!window.imagePopupKeydownListener) {
          document.addEventListener('keydown', (e) => {
              const currentPopup = document.getElementById('image-popup');
              if (e.key === 'Escape' && currentPopup && currentPopup.classList.contains('show')) {
                  closePopup();
              }
          });
          window.imagePopupKeydownListener = true;
      }

      // Mark the popup so we don't re-attach listeners on subsequent navigations
      popup.dataset.listenersAttached = 'true';
  }

  // Use astro:page-load event which is the standard for handling scripts
  // in Astro with View Transitions. It fires on initial load and after navigations.
  document.addEventListener('astro:page-load', setupImagePopupListeners);
</script>