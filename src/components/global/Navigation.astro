---
import { Image } from "astro:assets";
import imageSrc from "public/favicons/android-chrome-512x512.png"; // O desde 'public/images'
---

<div class="border-b w-full border-zinc-200 bg-stone-100">
  <div
    x-data="{ open: false }"
    class="relative flex flex-col w-full mx-auto md:items-center md:justify-between md:flex-row"
  >
    <div class="flex flex-row items-center justify-end md:justify-start">
      <button
        aria-label="Abrir menú"
        @click="open = !open"
        class="inline-flex items-center justify-center p-6 text-black hover:text-gray-600 focus:outline-none focus:text-black md:hidden"
      >
        <svg
          class="w-6 h-6"
          stroke="currentColor"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            :class="{'hidden': open, 'inline-flex': !open }"
            class="inline-flex"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
          <path
            :class="{'hidden': !open, 'inline-flex': open }"
            class="hidden"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="w-full md:mx-8 lg:mx-20">
      <nav
        :class="open ? 'max-h-screen' : 'max-h-0'"
        class="w-full overflow-hidden transition-all duration-700 ease-in-out md:flex md:max-h-full md:overflow-visible"
        x-data="{ active: window.location.pathname }"
      >
        <ul
          class="flex flex-col md:flex-row w-full space-y-2 list-none md:space-y-0 items-center md:justify-between text-center text-sm mb-4 md:mb-0"
        >
          <li class="w-24">
            <a class="hidden md:block" href="/">
              <Image
                src={imageSrc}
                alt="asd"
                width="100"
                height="100"
                loading="eager"
              />
            </a>
          </li>

          <div class="md:flex md:mx-auto md:gap-x-4">
            <li class="flex flex-col items-center md:px-2">
              <a
                href="/"
                :class="active === '/' ? 'rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Inicio
              </a>
            </li>

            <li class="flex flex-col items-center md:px-2">
              <a
                href="/libros"
                :class="active.includes('/libros') ? 'rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Libros
              </a>
            </li>

            <li class="flex flex-col items-center md:px-2">
              <a
                href="/librerias"
                :class="active.includes('/librerias') ? 'rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Librerías
              </a>
            </li>

            <li class="flex flex-col items-center md:px-2">
              <a
                href="/nosotros"
                :class="active.includes('/nosotros') ? 'rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Nosotros
              </a>
            </li>

            <li class="sm:hidden flex flex-col items-center md:px-2">
              <a
                href="/creditos"
                :class="active.includes('/creditos') ? 'rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Créditos
              </a>
            </li>

            <li class="flex flex-col items-center md:px-2">
              <a
                href="/contacto"
                :class="active.includes('/contacto') ? 'rounded-full px-3 py-2 bg-gray-900 text-white mb-2 md:mb-0' : 'text-black hover:text-gray-600 px-3 py-2'"
              >
                Contacto
              </a>
            </li>

            <li class="flex flex-col items-center md:px-2">
              <a
                href="https://eldestinoediciones.empretienda.com.ar"
                target="_blank"
                class="rounded-full px-3 py-2 bg-[#ecfd83] hover:bg-black hover:text-[#ecfd83] hover:transition ease-in-out duration-300 ring-1 fotn-bold"
              >
                ¡Tienda!
              </a>
            </li>
          </div>

          <!-- <li class="flex flex-col items-center md:px-2">
            <a
              href="https://titolectura.empretienda.com.ar"
              target="_blank"
              class="text-sm rounded-full px-3 py-2 ml-0 md:ml-4 bg-[#ecfd83] hover:bg-black hover:text-[#ecfd83] hover:transition ease-in-out duration-300 text-black ring-2"
            >
              Tienda
            </a>
          </li> -->
        </ul>
      </nav>
    </div>
  </div>

  <!-- class="py-1.5 px-4 border focus:ring-2 h-8 rounded-full border-transparent bg-black hover:bg-black/10 text-white duration-200 focus:ring-offset-2 focus:ring-white hover:text-black inline-flex items-center justify-center ring-1 ring-transparent lg:ml-auto" -->
</div>
