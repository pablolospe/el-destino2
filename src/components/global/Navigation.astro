---
import { Image } from "astro:assets";
import imageSrc from "public/favicons/android-chrome-512x512.png"; // O desde 'public/images'
---

<div class="border-b w-full border-zinc-200">
  <div
    x-data="{ open: false }"
    class="relative flex flex-col w-full mx-auto md:items-center md:justify-between md:flex-row"
  >
    <div class="flex flex-row items-center justify-end md:justify-start">
      <button
        @click="open = !open"
        class="inline-flex items-center justify-center p-6 text-black hover:text-gray-600 focus:outline-none focus:text-black md:hidden"
      >
        <svg
          class="w-6 h-6"
          stroke="currentColor"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            :class="{'hidden': open, 'inline-flex': !open }"
            class="inline-flex"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
          <path
            :class="{'hidden': !open, 'inline-flex': open }"
            class="hidden"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="w-full md:mx-8 lg:mx-20 ">
      <nav
        :class="{'flex': open, 'hidden': !open}"
        class="w-full hidden md:flex"
        x-data="{ active: window.location.pathname }"
      >
        <ul
          class="flex flex-col md:flex-row w-full space-y-2 list-none md:space-y-0 items-center md:inline-flex justify-between text-center text-md mb-4 md:mb-0"
        >
          <li class="w-24">
            <a class="hidden md:block" href="/">
              <Image src={imageSrc} alt="asd" width="100" height="100" loading="eager" />
            </a>
          </li>

          <li class="w-0 lg:w-20 xl:w-40 flex"></li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="/"
              :class="active === '/' ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Inicio
            </a>
          </li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="/libros"
              :class="active.includes('/libros') ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Libros
            </a>
          </li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="/librerias"
              :class="active.includes('/librerias') ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Librerías
            </a>
          </li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="/nosotros"
              :class="active.includes('/nosotros') ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Nosotros
            </a>
          </li>

          <li class="sm:hidden w-20 flex flex-col items-center">
            <a
              href="/creditos"
              :class="active.includes('/creditos') ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Créditos
            </a>
          </li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="/contacto"
              :class="active.includes('/contacto') ? 'border-black rounded-full px-3 py-2 bg-gray-900 text-white' : 'text-black hover:text-gray-600 px-3 py-2'"
            >
              Contacto
            </a>
          </li>

          <li class="w-20 flex flex-col items-center">
            <a
              href="https://titolectura.empretienda.com.ar"
              target="_blank"
              class="text-sm rounded px-3 py-2 ml-0 md:ml-4 bg-[#ecfd83] hover:bg-[#c0e360] hover:transition ease-in-out duration-600 text-black"
            >
              Tienda
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- class="py-1.5 px-4 border focus:ring-2 h-8 rounded-full border-transparent bg-black hover:bg-black/10 text-white duration-200 focus:ring-offset-2 focus:ring-white hover:text-black inline-flex items-center justify-center ring-1 ring-transparent lg:ml-auto" -->
</div>
