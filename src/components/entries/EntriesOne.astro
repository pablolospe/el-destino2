---
import { Image } from "astro:assets";

const { title, url, description, pubDate, author, image, tags } = Astro.props;
---

<li class="flex flex-col h-full w-auto justify-center ">
  <a href={url} title={title} class="h-full justify-center flex flex-col">

    <!-- I M G  N O T  M O B I L E -->
    <Image
      transition:name={`portada${image}`}
      class="hidden sm:flex h-auto w-auto shadow-xl shadow-gray-400 "
      height={800}
      width={400}
      src={image}
      alt={title}
      loading="eager"
    />

    <!-- I M G  M O B I L E -->
    <Image
      transition:name={`portada${image}`}
      class="block sm:hidden object-cover bg-center h-full w-full "
      height={200}
      width={200}
      src={image}
      alt={title}
      loading="eager"
    />
  </a>
</li>
