---
import "../styles/global.css";
import { AstroSeo } from "@astrolib/seo";
import { siteConfig } from "@/config/seo-aeo";

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonical = siteConfig.siteUrl,
  ogImage = siteConfig.defaultOgImage,
} = Astro.props;

// Ensure OG image is an absolute URL
const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteConfig.siteUrl.replace(/\/$/, "")}${ogImage}`;
---
<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: title,
    description: description,
    images: [
      {
        url: absoluteOgImage,
        width: 1200,
        height: 630,
        alt: `Portada - ${title}`,
        type: "image/jpeg",
      },
    ],
    site_name: "El Destino Ediciones",
    type: "website"
  }}
/>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6S7WSLGP1J"></script>
<script is:inline>
