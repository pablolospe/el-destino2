---
import { Image } from "astro:assets";
import { fade } from "astro:transitions";
import banner from "public/images/banner_tienda.png"; // O desde 'public/images'
---

<section>
  <div class="px-8 py-8 md:px-12 mx-auto lg:pb-8 lg:py-12 lg:px-8 w-full">
    <div class="flex flex-col justify-center items-center">
      <Image
        transition:animate={fade({ duration: "0.7s" })}
        loading="eager"
        class="object-contain w-full max-w-sm mx-auto aspect-[4305/1168]"
        src={banner}
        alt="Banner de El Destino Ediciones"
        width="1200"
        height="326"
      />
      <div class="flex flex-col justify-center items-center">
        <h1
          transition:animate={fade({ duration: "1s" })}
          class="text-2xl text-center tracking-widest font-bold font-display text-black"
        >
          Libros para amantes de los libros
        </h1>
      </div>
    </div>
  </div>
</section>
