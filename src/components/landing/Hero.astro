---
import { Image } from "astro:assets";
import { fade } from "astro:transitions";
import banner from "public/images/banner_tienda.png"; // O desde 'public/images'
---

<section >
  <div class="px-8 py-4 md:px-12 mx-auto lg:pb-8 lg:px-8 w-full">
    <div class="flex flex-col justify-center items-center">

      <Image 
      transition:animate={fade({duration:'0.5s'})}
      src={banner} alt="asd" width="300" height="300" />

      <h1 
      transition:animate={fade({duration:'0.8s'})}
      class="text-2xl w-full text-center tracking-tight text-balance font-medium font-display text-black">
        Libros para amantes de los libros
      </h1>


    </div>
  </div>
</section>
