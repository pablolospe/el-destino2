---
import { Image } from "astro:assets";
import banner from "public/images/banner_tienda.png"; // O desde 'public/images'
---

<section >
  <div class="px-8 py-4 md:px-12 mx-auto lg:pb-8 max-w-7xl lg:px-8 lg:pt-8">
    <div class="flex flex-col justify-center items-center">

      <Image src={banner} alt="asd" width="300" height="100" />

      
      <h1 class="text-4xl tracking-tight text-balance font-medium font-display text-black md:text-3xl">
        Libros para amantes de los libros
      </h1>
<!-- 
      <h2 class="text-2xl tracking-tight text-balance font-medium font-display text-black md:text-3xl">
        30 años haciendo libros
      </h2> -->

    </div>
  </div>
</section>
