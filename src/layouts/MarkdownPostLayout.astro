---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title={frontmatter.title}
  description={frontmatter.description}
  canonical="https://www.lexingtonthemes.com"
  openGraph={{
    url: "https://www.lexingtonthemes.com",
    title: "Open Graph Title",
    description: "Open Graph Description",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "www.el-destino.com",
  }}
  twitter={{
    handle: "@TwitterHandle",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>

<BaseLayout>
  <div class="px-8 py-8 md:px-12 mx-auto max-w-7xl lg:px-52">
    <div class="text-center">
      <h1
        class="text-2xl tracking-tight text-balance font-medium font-display text-black md:text-3xl"
      >
        {frontmatter.title}
      </h1>

      <h2
        class="text-xl tracking-tight text-balance font-medium font-display text-black md:text-2xl"
      >
        de {frontmatter.author}
      </h2>

      <button
        class="relative bg-gray-50 hover:bg-gray-100 text-gray-700 font-bold py-2 px-3 rounded-lg inline-flex items-center cursor-pointer"
        onclick="history.back()"
      >
        <svg
          class="fill-current w-4 h-4 mr-2"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
        >
          <path
            d="M10 3.414l-6.293 6.293a1 1 0 0 0 0 1.414l6.293 6.293a1 1 0 0 0 1.414-1.414L6.414 11H19a1 1 0 0 0 1-1V10a1 1 0 0 0-1-1H6.414l4.999-4.999a1 1 0 0 0-1.414-1.414z"
          ></path>
        </svg>
      </button>

      <section class="mt-4">
        <article
          class="grid grid-cols-1 md:grid-cols-5 justify-start md:gap-16"
        >
          <div class="w-full col-span-2">
            <Image
              transition:name={`portada${frontmatter.image.url}`}
              class="w-full shadow-2xl shadow-gray-500"
              height={200}
              width={200}
              src={frontmatter.image.url}
              alt={frontmatter.image.alt}
            />
          </div>

          <div class="w-full col-span-3 mt-10 md:mt-0">
            <div class="flex justify-between">
              <ul class="text-left font-sans">
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zink-600"
                >
                  {frontmatter.type}
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zink-600"
                >
                  {frontmatter.pages} páginas
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zink-600"
                >
                  {frontmatter.size}
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zink-600"
                >
                  {frontmatter.bookbinding}
                </li>
              </ul>

              <a
                href={frontmatter.tienda}
                target="_blank"
                class="bg-[#ecfd83] hover:bg-amber-200 hover:transition ease-in-out duration-600 flex flex-col justify-center font-bold rounded-lg px-4 h-12 cursor-pointer "
              >
                Comprar
              </a>
            </div>
            <br />

            <p class="text-left text-black text-lg lg:text-xl font-normal">
              {frontmatter.description}
            </p>
          </div>
        </article>

        <br />
        <br />

        <!-- A U T O R -->
        <article class="grid grid-cols-1 md:grid-cols-5 md:gap-16">
          <div class="w-full col-span-2">
            <Image
              class="w-full shadow-2xl shadow-gray-500"
              height={400}
              width={200}
              src={frontmatter.portrait.url}
              alt={frontmatter.portrait.alt}
            />
          </div>

          <p
            class="w-full text-left col-span-3 text-lg lg:text-xl font-light mt-4 md:mt-0"
          >
            {frontmatter.bio}
          </p>
        </article>
      </section>
      <div
        class="text-sm prose text-neutral-600 prose-a:font-normal prose-a:text-blue-400 hover:prose-a:text-black prose-h1:text-black prose-img:border-2 prose-img:bg-neutral-50 prose-img:border-transparent prose-h2:text-black prose-h2:font-semibold prose-p:text-sm prose-pre:font-mono max-w-none prose-pre:rounded-none prose-headings:font-display"
      >
        <slot />
      </div>
    </div>
  </div>
  <br />
</BaseLayout>
