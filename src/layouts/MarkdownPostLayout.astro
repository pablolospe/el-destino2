---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
const { frontmatter, prevPost, nextPost } = Astro.props;
import arrow from "public/images/arrow_direction_left_back_icon.svg"; // O desde 'public/images'
import { AstroSeo } from "@astrolib/seo";
import ImagePopup from "../components/ImagePopup.astro";

const title = frontmatter.title;
const description = frontmatter.description;

// Aspect ratio lookup maps to prevent Cumulative Layout Shift (CLS)
const coverDimensions: Record<string, { width: number; height: number }> = {
  "/images/tapas/breve_manual_mockup.webp": { width: 1755, height: 1890 },
  "/images/tapas/hipotesis_tapa.webp": { width: 1454, height: 2088 },
  "/images/tapas/LSyEC_mockup.webp": { width: 518, height: 851 },
  "/images/tapas/la_tienda_tapa.webp": { width: 1342, height: 1824 },
  "/images/tapas/lapislazuli_tapa.webp": { width: 1646, height: 2573 },
  "/images/tapas/siglas_tapa.webp": { width: 1698, height: 2717 },
  "/images/tapas/sisu_tapa.webp": { width: 1838, height: 2669 },
};

const portraitDimensions: Record<string, { width: number; height: number }> = {
  "/images/autores/sofi_foto_cortada.webp": { width: 517, height: 851 },
  "/images/autores/autora_tere.webp": { width: 1744, height: 1721 },
  "/images/autores/gustavo_foto_web.webp": { width: 519, height: 852 },
  "/images/autores/autora_noe.webp": { width: 884, height: 1334 },
  "/images/autores/autor_agus.webp": { width: 1600, height: 1600 },
  "/images/autores/autoras_sol_y_cami.webp": { width: 1744, height: 1721 },
  "/images/autores/autor_gerardo.webp": { width: 3780, height: 4724 },
};

const coverDims = coverDimensions[frontmatter.image.url] || { width: 550, height: 800 };
const portraitDims = frontmatter.portrait ? (portraitDimensions[frontmatter.portrait.url] || { width: 600, height: 900 }) : null;
---


<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={`${Astro.site.origin}${Astro.url.pathname}`}
  openGraph={{
    url: `${Astro.site.origin}${Astro.url.pathname}`,
    title: frontmatter.title,
    description: frontmatter.description,
    images: [
      {
        url: `${Astro.site.origin}${frontmatter.image.url}`,
        width: 1200,
        height: 630,
        alt: frontmatter.image.alt,
        type: "image/webp",
      },
    ],
    site_name: "El Destino Ediciones",
  }}
/>

<BaseLayout>
  <div id="swipe-container" data-prev={prevPost ? `/posts/${prevPost.slug}` : ""} data-next={nextPost ? `/posts/${nextPost.slug}` : ""} class="px-8 pt-12 pb-8 md:px-12 mx-auto max-w-7xl lg:px-52">
    
    <!-- Top Navigation & Swipe Hint -->
    <div class="flex justify-center mb-8 md:mb-12 text-xs uppercase font-sans tracking-wider text-neutral-400">
      <!--
      <a href="/libros" class="hover:text-black transition-colors duration-300 flex items-center gap-1.5">
        <Image src={arrow} alt="Volver" width={14} height={14} class="opacity-60" />
        <span>Libros</span>
      </a>
      -->
      <span class="md:hidden text-[10px] tracking-widest animate-pulse">
        ← Desliza para navegar →
      </span>
    </div>

    <div class="text-center">
      <div class="flex flex-row justify-center">
        <div>
        <h1
          class="text-3xl md:text-3xl w-full tracking-tight text-balance font-medium font-display text-black mb-1"
        >
          {frontmatter.title}
        </h1>
        <h3
          class="text-xl md:text-xl w-full tracking-tight text-balance font-medium font-display text-black mb-2"
        >
          {frontmatter.subtitle}
        </h3>
      </div>
      </div>
      <h2
        class="text-xl tracking-tight text-balance font-medium font-display text-black md:text-2xl mb-6"
      >
        de {frontmatter.author}
      </h2>

      <section class="mt-10">
        <article
          class="grid grid-cols-1 md:grid-cols-5 justify-start md:gap-16"
        >
          <div class="w-full col-span-2">
            <div class="cursor-pointer" onclick={`openImagePopup('${frontmatter.image.url}')`}>
              <Image
                transition:name={`portada${frontmatter.image.url}`}
                class="w-full shadow-lg md:shadow-2xl shadow-gray-400"
                height={coverDims.height}
                width={coverDims.width}
                style={`aspect-ratio: ${coverDims.width} / ${coverDims.height};`}
                src={frontmatter.image.url}
                alt={frontmatter.image.alt}
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>

          <div class="w-full col-span-3 mt-10 md:mt-0">
            <div class="flex justify-between">
              <ul class="text-left font-sans">
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zinc-600"
                >
                  {frontmatter.type}
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zinc-600"
                >
                  {frontmatter.pages} páginas
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zinc-600"
                >
                  {frontmatter.size}
                </li>
                <li
                  class="tracking-tight text-balance font-extralight text-sm text-zinc-600"
                >
                  {frontmatter.bookbinding}
                </li>
              </ul>

              <div class="flex flex-col gap-2">
                <a
                  href={frontmatter.tienda}
                  target="_blank"
                  class="bg-[#ecfd83] hover:bg-black hover:text-[#ecfd83] transition ease-in-out duration-300 flex flex-col justify-center font-bold rounded-full px-6 h-12 cursor-pointer text-center text-md ring-1"
                >
                  Libro físico
                </a>
                {frontmatter.eBook && (
                  <a
                    href={frontmatter.eBook}
                    target="_blank"
                    class="bg-[#ecfd83] hover:bg-black hover:text-[#ecfd83] transition ease-in-out duration-300 flex flex-col justify-center font-bold rounded-full px-6 h-12 cursor-pointer text-center text-md ring-1"
                  >
                    Libro digital
                  </a>
                )}
              </div>
            </div>
            <br />

            <p class="text-left text-black text-lg lg:text-xl font-normal" set:html={frontmatter.description}>
            </p>
        </article>

        <div class="border-t border-zinc-100 my-12 md:my-16"></div>

        <!-- A U T O R -->
        <article class="grid grid-cols-1 md:grid-cols-5 md:gap-16">
          <div class="w-full col-span-2">
            {frontmatter.portrait && portraitDims && (
              <div class="cursor-pointer" onclick={`openImagePopup('${frontmatter.portrait.url}')`}>
                <Image
                  transition:name={`autor${frontmatter.portrait.url}`}
                  class="w-full drop-shadow-lg md:drop-shadow-2xl"
                  height={portraitDims.height}
                  width={portraitDims.width}
                  style={`aspect-ratio: ${portraitDims.width} / ${portraitDims.height};`}
                  src={frontmatter.portrait.url}
                  alt={frontmatter.portrait.alt}
                />
              </div>
            )}
          </div>

          <div
          class="w-full text-left col-span-3 text-lg lg:text-xl font-light mt-10 md:mt-0"
          >
            <p set:html={frontmatter.bio} />
          </div>
        </article>
      </section>

      <!-- Bottom Navigation -->
      <div class="border-t border-zinc-100 pt-8 mt-16 flex items-center justify-between font-sans text-xs uppercase tracking-wider">
        {prevPost ? (
          <a href={`/posts/${prevPost.slug}`} class="flex items-center gap-2 text-neutral-400 hover:text-black transition-colors duration-300 group">
            <Image class="opacity-40 group-hover:-translate-x-1 transition-transform duration-300" src={arrow} alt="Anterior" width={14} height={14} />
            <span class="hidden sm:inline max-w-[180px] truncate">{prevPost.title}</span>
            <span class="sm:hidden">Anterior</span>
          </a>
        ) : (
          <div />
        )}
        
        <a href="/libros" class="text-neutral-400 hover:text-black transition-colors duration-300 font-semibold">
          Ver todos
        </a>

        {nextPost ? (
          <a href={`/posts/${nextPost.slug}`} class="flex items-center gap-2 text-neutral-400 hover:text-black transition-colors duration-300 group">
            <span class="hidden sm:inline max-w-[180px] truncate">{nextPost.title}</span>
            <span class="sm:hidden">Siguiente</span>
            <Image class="opacity-40 group-hover:translate-x-1 transition-transform duration-300 rotate-180" src={arrow} alt="Siguiente" width={14} height={14} />
          </a>
        ) : (
          <div />
        )}
      </div>

    </div>
  </div>

  <!-- Desktop Side Floating Navigation Arrows -->
  {prevPost && (
    <a 
      href={`/posts/${prevPost.slug}`}
      class="hidden lg:flex fixed left-6 top-1/2 -translate-y-1/2 items-center justify-center w-12 h-12 rounded-full hover:bg-neutral-50 transition-all duration-300 z-40 group"
      title={`Anterior: ${prevPost.title}`}
    >
      <Image 
        class="opacity-30 group-hover:opacity-100 group-hover:-translate-x-1 transition-all duration-300"
        src={arrow} 
        alt="Anterior" 
        width={24} 
        height={24} 
      />
    </a>
  )}

  {nextPost && (
    <a 
      href={`/posts/${nextPost.slug}`}
      class="hidden lg:flex fixed right-6 top-1/2 -translate-y-1/2 items-center justify-center w-12 h-12 rounded-full hover:bg-neutral-50 transition-all duration-300 z-40 group"
      title={`Siguiente: ${nextPost.title}`}
    >
      <Image 
        class="opacity-30 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 rotate-180"
        src={arrow} 
        alt="Siguiente" 
        width={24} 
        height={24} 
      />
    </a>
  )}

  <br />
  <ImagePopup transitionName={`portada${frontmatter.image.url}`} />
</BaseLayout>

<script>
  function initSwipeNavigation() {
    const container = document.getElementById('swipe-container');
    if (!container) return;

    const prevUrl = container.getAttribute('data-prev');
    const nextUrl = container.getAttribute('data-next');

    let touchstartX = 0;
    let touchstartY = 0;
    let touchendX = 0;
    let touchendY = 0;
    let isSwiping = false;

    const threshold = 80; // minimum horizontal swipe distance in pixels
    const restraint = 100; // maximum vertical movement allowed to prevent triggering during scrolls

    // Remove existing event listeners if any to prevent duplicates on view transition re-runs
    document.removeEventListener('touchstart', handleTouchStart);
    document.removeEventListener('touchmove', handleTouchMove);
    document.removeEventListener('touchend', handleTouchEnd);

    document.addEventListener('touchstart', handleTouchStart, { passive: true });
    document.addEventListener('touchmove', handleTouchMove, { passive: false });
    document.addEventListener('touchend', handleTouchEnd, { passive: true });

    function handleTouchStart(e: TouchEvent) {
      touchstartX = e.changedTouches[0].screenX;
      touchstartY = e.changedTouches[0].screenY;
      isSwiping = true;
    }

    function handleTouchMove(e: TouchEvent) {
      if (!isSwiping) return;
      const currentX = e.touches[0].screenX;
      const currentY = e.touches[0].screenY;
      const deltaX = currentX - touchstartX;
      const deltaY = currentY - touchstartY;

      // If they are swiping mostly horizontally, move the container for elastic feedback
      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaY) < restraint) {
        if ((deltaX < 0 && nextUrl) || (deltaX > 0 && prevUrl)) {
          // Prevent default scrolling behavior when actively swiping horizontally
          if (e.cancelable) e.preventDefault();
          container.style.transition = 'none';
          container.style.transform = `translateX(${deltaX / 3.5}px)`;
        }
      }
    }

    function handleTouchEnd(e: TouchEvent) {
      if (!isSwiping) return;
      isSwiping = false;
      touchendX = e.changedTouches[0].screenX;
      touchendY = e.changedTouches[0].screenY;
      
      // Animate returning to normal position
      container.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
      container.style.transform = '';

      handleGesture();
    }

    function handleGesture() {
      const deltaX = touchendX - touchstartX;
      const deltaY = touchendY - touchstartY;

      // Check if the swipe was horizontal and not a vertical scroll
      if (Math.abs(deltaX) >= threshold && Math.abs(deltaY) <= restraint) {
        if (deltaX < 0 && nextUrl) {
          // Swipe left -> Next book
          window.location.href = nextUrl;
        } else if (deltaX > 0 && prevUrl) {
          // Swipe right -> Previous book
          window.location.href = prevUrl;
        }
      }
    }
  }

  // Initialize swipe triggers on initial load and navigation view transitions
  document.addEventListener('astro:page-load', initSwipeNavigation);
</script>